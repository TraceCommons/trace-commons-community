---
import Base from "../layouts/Base.astro";

// Integration walkthrough for a hackathon platform consuming the score
// read-back. Reachable by link but deliberately absent from the header nav
// and marked noindex: it is partner-facing documentation, not part of the
// public community surface.
const description =
  "How devfolio scopes a participant's trace upload to one hackathon project, collects the envelope ids, and pulls scores for those ids to rank the competition.";

const parties = [
  {
    party: "Participant",
    does: "Runs the contributor CLI against the hackathon project and attaches the resulting ids.json to their devfolio entry.",
  },
  {
    party: "devfolio",
    does: "Stores those ids against the entry, calls the score read-back with them, and ranks entries on credit_quality.",
  },
  {
    party: "Trace Commons",
    does: "Gates and scores each uploaded trace, returns scores by id, and issues devfolio a read credential.",
  },
];

const bundle = [
  {
    field: "credit_quality_micros",
    type: "int | null",
    meaning:
      "Graded credit quality q x 1,000,000, so 284000 is 0.284. This is the ranking field. Null until the credit-quality pass has scored that trace.",
  },
  {
    field: "perplexity_micros",
    type: "int",
    meaning:
      "How surprising the trace is to the scoring model, x 1,000,000. Low values mean thin or boilerplate work.",
  },
  {
    field: "novelty_score_micros",
    type: "int",
    meaning:
      "How distinct the trace is from what has already been contributed, x 1,000,000. This catches near-duplicate submissions.",
  },
  {
    field: "gate_passed",
    type: "bool",
    meaning:
      "Whether the trace cleared both the novelty and substance floors. A cheap first filter to apply before reading q.",
  },
];

const cases = [
  {
    situation: "A requested id is absent from the response",
    result: "omitted",
    meaning:
      "The trace was uploaded but is not yet gated, or was never uploaded. Retry later rather than recording a zero.",
  },
  {
    situation: "Row present, q is null",
    result: "null",
    meaning: "Gated, but not credit-scored yet. Rank on the gate result until q fills in.",
  },
  {
    situation: "Wrong or missing credential",
    result: "403",
    meaning: "The token is not a competition read credential. Nothing partial is returned.",
  },
  {
    situation: "More than 500 ids in one request",
    result: "413",
    meaning: "Chunk the batch. Nothing is read before the cap is checked.",
  },
  {
    situation: "Scoring backend unavailable",
    result: "503",
    meaning:
      "A deliberate fail-closed, never a silent empty list that would read as everyone scoring nothing.",
  },
];

// Illustrative rows. The values are synthetic but deliberately sized to the
// range real traces actually occupy: q is bottom-clustered, so a strong entry
// sits near 0.3 rather than near 1.0, and a gate failure is usually the
// novelty floor with perplexity passing. Do not round these up to look
// impressive. The whole point is that a consumer sizes their UI correctly.
const board = [
  { rank: 1, entry: "nightjar / 7c9f1a2e", q: "0.284", gate: "pass" },
  { rank: 2, entry: "kestrel / b81c40df", q: "0.161", gate: "pass" },
  { rank: 3, entry: "tern / 2ad4e8b1", q: "0.052", gate: "fail" },
];
---

<Base title="devfolio integration" description={description}>
  <meta slot="head" name="robots" content="noindex, nofollow" />

  <h2 class="lede-head">Score a hackathon from the traces participants produce</h2>
  <p class="lede">
    A participant uploads the coding-agent traces from one project and passes the
    resulting envelope ids to devfolio. devfolio pulls scores for those ids and ranks
    the competition on them.
  </p>

  <h2>The join key</h2>
  <ul>
    <li>
      <code>submission_id</code> identifies a single uploaded trace. Trace Commons
      assigns one to every trace at upload.
    </li>
    <li>
      The contributor CLI writes the ids to a manifest file, and devfolio stores them
      against the hackathon entry.
    </li>
    <li>
      The score read-back is keyed by those same ids. No other identifier is required.
    </li>
    <li>
      Traces carry no devfolio-specific fields, so the entry-to-ids mapping stays
      inside devfolio and can change independently.
    </li>
  </ul>

  <h2>Who does what</h2>
  <div class="tablewrap">
    <table>
      <thead>
        <tr><th>Party</th><th>Responsibility</th></tr>
      </thead>
      <tbody>
        {parties.map((row) => (
          <tr>
            <td class="nowrap"><strong>{row.party}</strong></td>
            <td>{row.does}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <section class="stage">
    <h2>Step 1. The participant uploads the hackathon project</h2>
    <p>
      By default the contributor CLI treats every coding-agent session on the machine
      as a candidate, which is far too much for a hackathon. <code>--project</code>
      narrows the batch to sessions whose working directory sits at or under one path.
      Matching uses the session's real working directory rather than the folder name,
      so a project named <code>my-hack</code> matches correctly.
    </p>
    <pre><code>$ cd ~/code/my-hack
$ trace-commons-contributor submit --project . --manifest ids.json

  3 sessions match ~/code/my-hack
  submitted 7c9f1a2e-4b30-4d81-9f52-1e6a0c33bd77 accepted
  submitted 2ad4e8b1-6c07-4a99-8e13-5b70f2c4a901 accepted
  refused (residual-secret-detected)

  wrote 2 envelope id(s) to manifest</code></pre>
    <ul>
      <li>
        The refusal comes from the local scrubbing pass. A session that still carries a
        credential after redaction is never uploaded and never reaches the manifest.
      </li>
      <li>
        Sessions are processed independently, so one refusal does not cost the rest of
        the batch.
      </li>
    </ul>
  </section>

  <section class="stage">
    <h2>Step 2. The participant hands over the manifest</h2>
    <p>
      <code>ids.json</code> lists exactly the envelopes that reached the server, with
      refusals and failures excluded. This is the file a participant attaches to their
      devfolio entry.
    </p>
    <pre><code>[
  &lbrace;
    "submission_id": "7c9f1a2e-4b30-4d81-9f52-1e6a0c33bd77",
    "status": "accepted"
  &rbrace;,
  &lbrace;
    "submission_id": "2ad4e8b1-6c07-4a99-8e13-5b70f2c4a901",
    "status": "already-submitted"
  &rbrace;
]</code></pre>
    <ul>
      <li>
        <code>already-submitted</code> means the participant uploaded that exact session
        before. The id is stable and still valid to score, so it belongs in the entry.
      </li>
      <li>
        The list is append-only per entry. A participant can re-run <code>submit</code>
        as the project evolves, which produces further ids for the same entry.
      </li>
      <li>
        <code>--manifest</code> is refused alongside <code>--dry-run</code>. A dry run
        mints ids locally without uploading, so those ids never exist on the server and
        can never be scored.
      </li>
    </ul>
  </section>

  <section class="stage">
    <h2>Step 3. devfolio pulls scores for the collected ids</h2>
    <ul>
      <li>One request carries up to 500 ids.</li>
      <li>
        Participants each live in their own tenant and this route reads across all of
        them, so a single call per batch is enough.
      </li>
    </ul>
    <pre><code>$ curl -X POST https://ingest.tracecommons.ai/v1/admin/scores-by-submission \
    -H "authorization: Bearer $DEVFOLIO_TOKEN" \
    -H "content-type: application/json" \
    -d '&lbrace;"submission_ids": ["7c9f1a2e-…", "2ad4e8b1-…"]&rbrace;'</code></pre>
    <pre><code>[
  &lbrace;
    "submission_id": "7c9f1a2e-4b30-4d81-9f52-1e6a0c33bd77",
    "credit_quality_micros": 284000,
    "perplexity_micros": 12400000,
    "novelty_score_micros": 210000,
    "gate_passed": true
  &rbrace;,
  &lbrace;
    "submission_id": "2ad4e8b1-6c07-4a99-8e13-5b70f2c4a901",
    "credit_quality_micros": null,
    "perplexity_micros": 9100000,
    "novelty_score_micros": 50000,
    "gate_passed": true
  &rbrace;
]</code></pre>
  </section>

  <h2>Score bundle reference</h2>
  <div class="tablewrap">
    <table>
      <thead>
        <tr><th>Field</th><th>Type</th><th>What it means</th></tr>
      </thead>
      <tbody>
        {bundle.map((row) => (
          <tr>
            <td><code>{row.field}</code></td>
            <td class="nowrap"><code>{row.type}</code></td>
            <td>{row.meaning}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <ul>
    <li>
      All scores are integers in millionths. No floats travel on the wire, so equal
      scores compare equal and a leaderboard sorts deterministically.
    </li>
    <li>
      When a trace has been scored more than once, the read-back returns the most
      recent decision.
    </li>
  </ul>

  <h2>Ranking on credit quality</h2>
  <p>
    <code>credit_quality</code> is the headline figure: a single graded number in
    [0,&nbsp;1] combining how much genuinely new work a trace represents against how
    substantial it is. It is the field to rank on.
  </p>
  <div class="tablewrap">
    <table>
      <thead>
        <tr><th>Rank</th><th>Entry</th><th>Credit quality</th><th>Gate</th></tr>
      </thead>
      <tbody>
        {board.map((row) => (
          <tr>
            <td class="num">{row.rank}</td>
            <td class="mono">{row.entry}</td>
            <td class="num">{row.q}</td>
            <td><span class={`pill pill-${row.gate}`}>{row.gate}</span></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <div class="callout">
    <p><strong>Size the display for a compressed range.</strong></p>
    <ul>
      <li>
        The scale runs to 1.0, but scores cluster near the bottom. Most scored traces
        land below 0.3, and a strong entry sits nearer 0.3 than 1.0.
      </li>
      <li>
        A linear 0-to-1 bar squashes every real entry into the left edge and looks
        broken.
      </li>
      <li>
        Rank on the raw value, but scale the visual to the spread actually received, or
        rank on position rather than magnitude.
      </li>
    </ul>
  </div>

  <h2>Cases to handle</h2>
  <div class="tablewrap">
    <table>
      <thead>
        <tr><th>Situation</th><th>Result</th><th>What it means for judging</th></tr>
      </thead>
      <tbody>
        {cases.map((row) => (
          <tr>
            <td>{row.situation}</td>
            <td class="nowrap"><code>{row.result}</code></td>
            <td>{row.meaning}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2>The read credential</h2>
  <ul>
    <li>
      devfolio receives a competition read credential that can call this one route and
      nothing else. It is not an admin token: it cannot read traces, export anything,
      or write.
    </li>
    <li>The credential is a signed token carrying <code>role=competition_read_worker</code>.</li>
    <li>Send it as <code>authorization: Bearer &lt;token&gt;</code>.</li>
    <li>Trace Commons issues it for the hackathon window and rotates it afterwards.</li>
    <li>
      If it leaks, the exposure is limited to reading scores for ids the holder already
      knows.
    </li>
  </ul>

  <h2>What the read-back never returns</h2>
  <ul>
    <li>No trace content, prompts, or code.</li>
    <li>No contributor identity and no tenant.</li>
    <li>
      The audit log of each read records only the surface name and the number of rows
      returned, not which ids were requested.
    </li>
  </ul>
  <div class="callout">
    <p><strong>Attribution stays with devfolio.</strong></p>
    <ul>
      <li>
        <code>submission_id</code> is derived from session content, so two participants
        who upload a byte-identical session share one id and one row.
      </li>
      <li>
        The score is a function of the content, so the value is correct either way, but
        a row is not evidence of who produced it.
      </li>
      <li>The entry-to-ids mapping held by devfolio is the authority on attribution.</li>
    </ul>
  </div>

  <p class="footer-note">
    Contributor CLI: <code>trace-commons-contributor</code> ·
    Route: <code>POST /v1/admin/scores-by-submission</code> ·
    All ids, scores, and rankings shown are examples, not live data.
  </p>
</Base>

<style>
  .lede-head { margin-top: 0.2rem; }

  .lede {
    font-size: 1.1rem;
    max-width: 62ch;
  }

  .callout {
    background: var(--row);
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: 4px;
    padding: 1rem 1.25rem;
    margin: 1.5rem 0;
  }

  .callout p { margin: 0 0 0.5rem; }
  .callout ul { margin: 0; }

  .stage {
    border-top: 1px solid var(--border);
    margin-top: 2.5rem;
    padding-top: 1rem;
  }

  p { max-width: 68ch; }

  ul {
    max-width: 68ch;
    padding-left: 1.15rem;
  }

  li { margin-bottom: 0.45rem; }

  pre {
    background: #10171a;
    color: #ccd8d6;
    padding: 1rem 1.15rem;
    border-radius: 4px;
    overflow-x: auto;
    font-size: 0.82rem;
    line-height: 1.65;
  }

  /* Reset every inline-code affordance inside a terminal block. The border in
     particular must go: a bordered inline box spanning multiple lines draws a
     border fragment on each line box, which boxes every line of the block. */
  pre code {
    background: none;
    border: 0;
    border-radius: 0;
    padding: 0;
    color: inherit;
    font-size: inherit;
  }

  code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.88em;
    background: var(--row);
    border: 1px solid var(--border);
    border-radius: 3px;
    padding: 0.05em 0.3em;
  }

  .footer-note {
    margin-top: 2.5rem;
    font-size: 0.85rem;
  }

  .tablewrap { overflow-x: auto; margin: 1.25rem 0; }
  .tablewrap table { min-width: 34rem; }
  .nowrap { white-space: nowrap; }

  /* The shared layout renders th in --muted; keep header text at full contrast. */
  th { color: var(--fg); }

  .mono {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.85rem;
  }

  .num {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .pill {
    display: inline-block;
    font-size: 0.66rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    padding: 0.14rem 0.42rem;
    border: 1px solid currentColor;
    border-radius: 3px;
  }

  .pill-pass { color: var(--accent); }
  .pill-fail { color: #a4432b; }

  @media (prefers-color-scheme: dark) {
    .pill-fail { color: #d4795c; }
  }
</style>

---
import Base from "../layouts/Base.astro";
import Hero from "../components/landing/Hero.astro";
import Worth from "../components/landing/Worth.astro";
import How from "../components/landing/How.astro";
import Earn from "../components/landing/Earn.astro";
import Rules from "../components/landing/Rules.astro";
import TopContributors from "../components/landing/TopContributors.astro";
import Join from "../components/landing/Join.astro";
import Closing from "../components/landing/Closing.astro";
---

<Base title="Keep the data your agents produce" landing>
  <Hero slot="hero" />

  <Worth />
  <How />
  <Earn />
  <Rules />
  <TopContributors />
  <Join />
  <Closing />

  {/* Ported from site-v2 and loaded only on this route, so no other page pays
      for three.js. `defer` keeps execution in source order, which matters:
      three.js has to be there before the globe and the coin run. `is:inline`
      stops Astro from bundling files that are deliberately verbatim. */}
  <Fragment slot="body-end">
    <script is:inline defer src="/vendor/three.min.js"></script>
    <script is:inline defer src="/scripts/main.js"></script>
    <script is:inline defer src="/scripts/coin.js"></script>
    <script is:inline defer src="/scripts/carousel.js"></script>
    <script is:inline defer src="/scripts/scroll.js"></script>
    <script is:inline defer src="/scripts/transcript.js"></script>
    <script is:inline defer src="/scripts/motion.js"></script>
  </Fragment>
</Base>

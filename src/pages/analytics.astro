---
import Base from "../layouts/Base.astro";
import snapshot from "../_data/snapshots/live-7d.json";
import type { Snapshot } from "../types";

const data = snapshot as Snapshot;
const a = data.analytics;
const maxHistogram = Math.max(...a.novelty_histogram.map((b) => b.count), 1);
const gateEntries = Object.entries(a.gate_outcomes).sort((x, y) => y[1] - x[1]);
const gateTotal = gateEntries.reduce((acc, [, n]) => acc + n, 0);
const isDummy = data.snapshot_id.startsWith("dummy-");
---

<Base title="Analytics">
  {
    isDummy && (
      <p class="banner" data-dummy-snapshot-banner>
        <strong>Preview build.</strong> These aggregates come from the fallback
        snapshot. Live figures carry the min-cell and noise guards applied at
        compute time.
      </p>
    )
  }

  <h2>Corpus analytics, <span data-analytics-window>{a.window}</span></h2>

  <div class="stat-grid">
    <div class="stat">
      <div class="label">Total submissions</div>
      <div class="value" data-stat-total-submissions>
        {a.total_submissions.toLocaleString()}
      </div>
    </div>
    <div class="stat">
      <div class="label">Accepted</div>
      <div class="value" data-stat-total-accepted>
        {a.total_accepted.toLocaleString()}
      </div>
    </div>
    <div class="stat">
      <div class="label">Rejected</div>
      <div class="value" data-stat-total-rejected>
        {a.total_rejected.toLocaleString()}
      </div>
    </div>
    <div class="stat">
      <div class="label">Accept rate</div>
      <div class="value" data-stat-accept-rate>
        {(a.accept_rate * 100).toFixed(0)}%
      </div>
    </div>
  </div>

  <div class="stack">
    <h2>Novelty score distribution</h2>
    <p class="muted">Bucketed in micros (0 to 1,000,000). Higher is more novel.</p>
  </div>

  <div class="table-scroll">
    <table>
      <thead>
        <tr>
          <th class="num">Bucket</th>
          <th class="num">Count</th>
          <th>Share of window</th>
        </tr>
      </thead>
      <tbody data-novelty-body>
        {
          a.novelty_histogram.map((b) => (
            <tr>
              <td class="num muted">{b.bucket_micros.toLocaleString()}</td>
              <td class="num">{b.count}</td>
              <td>
                <span
                  class="bar"
                  style={`width: ${(b.count / maxHistogram) * 100}%`}
                />
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <h2>Gate decision outcomes</h2>

  <div class="table-scroll">
    <table>
      <thead>
        <tr>
          <th>Outcome</th>
          <th class="num">Decisions</th>
          <th class="num">Share</th>
        </tr>
      </thead>
      <tbody data-gate-body>
        {
          gateEntries.map(([label, count]) => (
            <tr>
              <td>
                <code>{label}</code>
              </td>
              <td class="num">{count}</td>
              <td class="num">{((count / gateTotal) * 100).toFixed(1)}%</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <p class="muted" data-live-snapshot-status></p>

  <script>
    import "../scripts/live-snapshot";
  </script>
</Base>

<style>
  /* Global, not scoped: live-snapshot.ts rebuilds these rows with innerHTML,
     and injected nodes never carry the data-astro-cid attribute a scoped
     selector requires. Scoped, the bars would vanish on first refresh. */
  :global(.bar) {
    /* Square, like everything else in the frame. */
    display: inline-block;
    height: 10px;
    min-width: 2px;
    background: var(--accent);
  }
</style>

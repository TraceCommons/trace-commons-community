---
import Base from "../layouts/Base.astro";
import snapshot from "../_data/snapshots/live-7d.json";
import type { Snapshot } from "../types";
import {
  isPlaceholder,
  ANALYTICS_NOT_LIVE_HEADING,
  ANALYTICS_NOT_LIVE_BODY,
} from "../lib/snapshot";

const data = snapshot as Snapshot;
const a = data.analytics;

/* Two ways to have no aggregates, and this page treats them identically: a
   placeholder build, or a real snapshot whose analytics the server withheld
   while still publishing the roster. Either way there is nothing to assert. */
const withheld = isPlaceholder(data) || a === null;

/* Em dash rather than 0: a zero is a measurement, and there has not been one. */
const stat = (value: number | undefined) =>
  withheld || value === undefined ? "—" : value.toLocaleString();
const rate = (value: number | undefined) =>
  withheld || value === undefined ? "—" : `${(value * 100).toFixed(0)}%`;

const histogram = withheld ? [] : (a?.novelty_histogram ?? []);
const maxHistogram = Math.max(...histogram.map((b) => b.count), 1);
const gateEntries = withheld
  ? []
  : Object.entries(a?.gate_outcomes ?? {}).sort((x, y) => y[1] - x[1]);
const gateTotal = gateEntries.reduce((acc, [, n]) => acc + n, 0);
---

<Base title="Analytics">
  <p class="banner" data-dummy-snapshot-banner data-snapshot-surface="analytics" hidden={!withheld}>
    <strong>{ANALYTICS_NOT_LIVE_HEADING}.</strong> {ANALYTICS_NOT_LIVE_BODY}
  </p>

  <h2>
    Corpus analytics, <span data-analytics-window>
      {withheld ? "no window yet" : a?.window}
    </span>
  </h2>

  <div class="stat-grid">
    <div class="stat">
      <div class="label">Total submissions</div>
      <div class="value" data-stat-total-submissions>
        {stat(a?.total_submissions)}
      </div>
    </div>
    <div class="stat">
      <div class="label">Accepted</div>
      <div class="value" data-stat-total-accepted>{stat(a?.total_accepted)}</div>
    </div>
    <div class="stat">
      <div class="label">Rejected</div>
      <div class="value" data-stat-total-rejected>{stat(a?.total_rejected)}</div>
    </div>
    <div class="stat">
      <div class="label">Accept rate</div>
      <div class="value" data-stat-accept-rate>{rate(a?.accept_rate)}</div>
    </div>
  </div>

  <div class="stack">
    <h2>Novelty score distribution</h2>
    <p class="muted">Bucketed in micros (0 to 1,000,000). Higher is more novel.</p>
  </div>

  <div class="table-scroll" data-analytics-table hidden={withheld}>
    <table>
      <thead>
        <tr>
          <th class="num">Bucket</th>
          <th class="num">Count</th>
          <th>Share of window</th>
        </tr>
      </thead>
      <tbody data-novelty-body>
        {
          histogram.map((b) => (
            <tr>
              <td class="num muted">{b.bucket_micros.toLocaleString()}</td>
              <td class="num">{b.count}</td>
              <td>
                <span
                  class="bar"
                  style={`width: ${(b.count / maxHistogram) * 100}%`}
                />
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <h2>Gate decision outcomes</h2>

  <div class="table-scroll" data-analytics-table hidden={withheld}>
    <table>
      <thead>
        <tr>
          <th>Outcome</th>
          <th class="num">Decisions</th>
          <th class="num">Share</th>
        </tr>
      </thead>
      <tbody data-gate-body>
        {
          gateEntries.map(([label, count]) => (
            <tr>
              <td>
                <code>{label}</code>
              </td>
              <td class="num">{count}</td>
              <td class="num">{((count / gateTotal) * 100).toFixed(1)}%</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <p class="muted" data-live-snapshot-status></p>

  <script>
    import "../scripts/live-snapshot";
  </script>
</Base>

<style>
  /* Global, not scoped: live-snapshot.ts rebuilds these rows with innerHTML,
     and injected nodes never carry the data-astro-cid attribute a scoped
     selector requires. Scoped, the bars would vanish on first refresh. */
  :global(.bar) {
    /* Square, like everything else in the frame. */
    display: inline-block;
    height: 10px;
    min-width: 2px;
    background: var(--accent);
  }
</style>

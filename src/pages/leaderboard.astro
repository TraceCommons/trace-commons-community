---
import Base from "../layouts/Base.astro";
import snapshot from "../_data/snapshots/live-7d.json";
import type { Snapshot } from "../types";
import { isPlaceholder, NOT_LIVE_HEADING, NOT_LIVE_BODY } from "../lib/snapshot";

const data = snapshot as Snapshot;
const computedAt = new Date(data.computed_at);
const placeholder = isPlaceholder(data);
const rows = placeholder ? [] : data.leaderboard;
---

<Base title="Leaderboard">
  <div class="stack">
    <h2>Leaderboard, 7 day window</h2>
    {/* Both are always present so a live refresh can swap them without a
        rebuild: it fills the summary and hides anything marked as the
        placeholder notice. */}
    <p class="banner" data-dummy-snapshot-banner data-snapshot-surface="roster" hidden={!placeholder}>
      <strong>{NOT_LIVE_HEADING}.</strong> {NOT_LIVE_BODY}
    </p>

    <p class="muted" data-snapshot-summary hidden={placeholder}>
      Ranked by <code>{data.metric}</code>. Snapshot <code
        >{data.snapshot_id.slice(0, 12)}…</code
      > computed at {computedAt.toUTCString()}. Min-cell guard: {
        data.min_cell_count
      }.
    </p>
  </div>

  <div class="table-scroll" data-leaderboard-table hidden={placeholder}>
    <table>
      <thead>
        <tr>
          <th class="num">#</th>
          <th>Handle</th>
          <th class="num">Score</th>
          <th class="num">Accepted</th>
          <th class="num">Accept rate</th>
          <th class="num">Public since</th>
        </tr>
      </thead>
      <tbody data-leaderboard-body>
        {
          rows.length === 0 && !placeholder && (
            <tr>
              <td colspan="6" class="muted">
                No public contributors yet.
              </td>
            </tr>
          )
        }
        {
          rows.map((entry) => (
            <tr>
              <td class="num">{entry.rank}</td>
              <td>
                <a href={`/contributors/${entry.display_handle}`}>
                  {entry.display_handle}
                </a>
              </td>
              <td class="num">{entry.score.toFixed(1)}</td>
              <td class="num">{entry.accepted_count}</td>
              <td class="num">{(entry.accept_rate * 100).toFixed(0)}%</td>
              <td class="num muted">
                {new Date(entry.public_since).toISOString().slice(0, 10)}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <p class="muted">
    Contributors are only listed here if they have explicitly opted in to public
    attribution. See <a href="/about/privacy">the privacy page</a> for the consent
    flow and withdrawal procedure.
  </p>

  <p class="muted" data-live-snapshot-status></p>

  <script>
    import "../scripts/live-snapshot";
  </script>
</Base>

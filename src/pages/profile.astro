---
import Base from "../layouts/Base.astro";

// SPA endpoints come from build-time env so the same bundle can target
// any deployment. Default points at the pilot host; deploy pipelines
// can override TC_INGEST_BASE / TC_ISSUER_BASE.
const ingestBase = import.meta.env.TC_INGEST_BASE ?? "https://ingest.34-41-15-28.nip.io";
const issuerBase = import.meta.env.TC_ISSUER_BASE ?? "https://issuer.34-41-15-28.nip.io";
---
<Base title="Profile" description="Manage your Trace Commons public attribution.">
  <Fragment slot="head">
    <meta name="tc-ingest-base" content={ingestBase} />
    <meta name="tc-issuer-base" content={issuerBase} />
  </Fragment>

  <noscript>
    <p class="banner">
      The profile management page requires JavaScript. The rest of the site
      (leaderboard, contributor pages, analytics) does not.
    </p>
  </noscript>

  <div data-profile-app>
    <p class="muted">Loading…</p>
  </div>

  <style>
    [data-profile-app] form {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
      max-width: 34rem;
      margin: var(--space-5) 0;
      border: var(--hairline);
      padding: var(--space-4);
    }

    [data-profile-app] label {
      font-family: var(--mono-font);
      font-size: 12px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.02em;
      color: var(--muted);
    }

    [data-profile-app] input,
    [data-profile-app] textarea {
      font-family: var(--font-stack);
      font-size: 16px;
      font-weight: 500;
      text-transform: none;
      letter-spacing: -0.01em;
      color: var(--ink-color);
    }

    [data-profile-app] button {
      align-self: flex-start;
      font-family: var(--mono-font);
      font-size: 15px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: -0.01em;
      padding: var(--space-3) var(--space-4);
      border: var(--hairline);
      background: var(--accent);
      color: var(--on-accent);
      cursor: pointer;
    }

    [data-profile-app] button:hover {
      background: var(--accent-bright);
    }

    /* Withdrawal is destructive and deliberately not the button the eye lands
       on first. */
    [data-profile-app] [data-form="delete"] button {
      background: var(--bg-color);
      color: var(--ink-color);
    }

    [data-profile-app] [data-form="delete"] button:hover {
      background: var(--ink-color);
      color: var(--bg-color);
    }

    /* Both clear 4.5:1 on the white page. */
    [data-profile-app] .success {
      color: #0a6b2d;
      font-weight: 700;
    }

    [data-profile-app] .error {
      color: #b3121f;
      font-weight: 700;
    }
  </style>

  <script>
    import "../scripts/profile-app";
  </script>
</Base>

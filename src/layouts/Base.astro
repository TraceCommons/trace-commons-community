---
import "../styles/brand.css";

interface Props {
  title: string;
  description?: string;
  /* The landing page owns its own section layout and carries the four in-page
     anchors. Every other page gets the compact header and a reading column. */
  landing?: boolean;
}

const {
  title,
  description = "Open the record of what AI agents actually do. Trace Commons is a register of agent work held under contributor-set terms — public leaderboard, contributor profiles, and corpus analytics anyone can read.",
  landing = false,
} = Astro.props;

/* Same-origin by default, so the browser talks to the Pages worker in
   public/_worker.js rather than to ingest directly. connect-src in
   public/_headers only permits 'self' plus the two named hosts, so pointing
   this anywhere else needs the CSP updated with it. */
const communityApiBase = import.meta.env.TC_COMMUNITY_API_BASE ?? "/api";

/* Astro.site is the deployed origin, so these resolve to absolute URLs.
   Unfurlers reject relative ones. */
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL("/assets/og-card.png", Astro.site).href;
const socialTitle = landing ? "Trace Commons" : `${title} — Trace Commons`;

const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);

const appLinks = [
  { href: "/leaderboard", label: "Leaderboard" },
  { href: "/analytics", label: "Analytics" },
  { href: "/profile", label: "Profile" },
  { href: "https://docs.tracecommons.ai", label: "Docs" },
];

const sectionLinks = [
  { href: "#worth", label: "What a trace is" },
  { href: "#how", label: "How it works" },
  { href: "#earn", label: "How you earn" },
  { href: "#rules", label: "The rules" },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="tc-community-api-base" content={communityApiBase} />

    {/* Without these, link unfurlers have nothing authoritative to read and
        fall back to screenshotting the page — which renders the globe and the
        coin as empty boxes, because both are drawn by WebGL that no preview
        bot runs. The card below is a static image for exactly that reason. */}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Trace Commons" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Trace Commons — keep the data your agents produce" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <slot name="head" />
    <title>{title} — Trace Commons</title>
  </head>
  <body>
    <div class="app-wrapper">
      <main class="main-card">
        <div class={landing ? "screen" : ""}>
          <div class={landing ? "card-header" : "card-header is-compact"}>
            <h1 class="title">{landing ? <Fragment>TRACE<br />COMMONS</Fragment> : <a href="/">Trace Commons</a>}</h1>

            <div class="nav-stack">
              <nav class="local-nav" aria-label="Sections of the site">
                {appLinks.map((link) => (
                  <a href={link.href} aria-current={isCurrent(link.href) ? "page" : undefined}>
                    {link.label}
                  </a>
                ))}
              </nav>

              {landing && (
                <nav class="local-nav section-nav" aria-label="Sections of this page">
                  {sectionLinks.map((link) => (
                    <a href={link.href}>&gt; {link.label}</a>
                  ))}
                </nav>
              )}
            </div>
          </div>

          <slot name="hero" />
        </div>

        {landing ? <slot /> : <div class="page"><slot /></div>}

        <footer class="site-footer">
          <p>
            Trace Commons shows only the contributors who chose public attribution.
            Read the <a href="/about/privacy">privacy notes</a> and the
            <a href="/about/data-policy">data policy</a>.
            Source: <a href="https://github.com/TraceCommons/trace-commons-community">community site</a>,
            <a href="https://github.com/TraceCommons/trace-commons-server">server</a>.
          </p>
          <a class="powered-by" href="https://near.org">
            <img class="near-mark" src="/assets/near-logo.svg" alt="" />
            <span>Powered by NEAR</span>
          </a>
        </footer>
      </main>
    </div>

    <slot name="body-end" />
  </body>
</html>

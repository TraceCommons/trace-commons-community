---
interface Props {
  title: string;
  description?: string;
}
const { title, description = "Trace Commons community surface: leaderboard, contributor profiles, and aggregate analytics for a user-owned register of AI agent work." } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <slot name="head" />
    <title>{title} — Trace Commons</title>
    <style>
      :root {
        color-scheme: light dark;
        --bg: #fafafa;
        --fg: #222;
        --muted: #666;
        --accent: #115;
        --border: #ddd;
        --row: #fff;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #161616;
          --fg: #e8e8e8;
          --muted: #999;
          --accent: #aab;
          --border: #333;
          --row: #1d1d1d;
        }
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font: 16px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
        background: var(--bg);
        color: var(--fg);
      }
      header, footer, main {
        max-width: 880px;
        margin: 0 auto;
        padding: 1.5rem;
      }
      header {
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: baseline;
        gap: 1.5rem;
      }
      header h1 {
        margin: 0;
        font-size: 1.1rem;
        font-weight: 600;
      }
      header nav { font-size: 0.95rem; }
      header nav a {
        margin-right: 1rem;
        color: var(--fg);
        text-decoration: none;
      }
      header nav a:hover, header nav a:focus { text-decoration: underline; }
      footer {
        border-top: 1px solid var(--border);
        color: var(--muted);
        font-size: 0.85rem;
        margin-top: 3rem;
      }
      h2 { margin-top: 2rem; }
      a { color: var(--accent); }
      table { width: 100%; border-collapse: collapse; }
      th, td { padding: 0.5rem 0.75rem; text-align: left; border-bottom: 1px solid var(--border); }
      tbody tr { background: var(--row); }
      th { color: var(--muted); font-weight: 500; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.04em; }
      .muted { color: var(--muted); }
      .stat-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
        gap: 1rem;
        margin: 1.5rem 0;
      }
      .stat { padding: 1rem; background: var(--row); border: 1px solid var(--border); border-radius: 6px; }
      .stat .label { color: var(--muted); font-size: 0.85rem; }
      .stat .value { font-size: 1.4rem; font-weight: 600; }
      .banner {
        background: #fff3cd;
        color: #4a3a00;
        padding: 0.75rem 1rem;
        border-radius: 4px;
        margin-bottom: 1.5rem;
        border: 1px solid #ffe28a;
        font-size: 0.92rem;
      }
      @media (prefers-color-scheme: dark) {
        .banner { background: #3a300a; color: #ffe28a; border-color: #5a4a10; }
      }
    </style>
  </head>
  <body>
    <header>
      <h1><a href="/" style="color:var(--fg); text-decoration: none;">Trace Commons</a></h1>
      <nav>
        <a href="/leaderboard">Leaderboard</a>
        <a href="/analytics">Analytics</a>
        <a href="/about/privacy">Privacy</a>
        <a href="/about/data-policy">Data policy</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>
        Trace Commons is a user-owned register of AI agent work: captured and scrubbed locally,
        gated for novelty and substance on a shared server, signed and filed on-chain.
        This site shows only the contributors who have explicitly opted in to public attribution.
        Source: <a href="https://github.com/TraceCommons/trace-commons-community">trace-commons-community</a> · <a href="https://github.com/TraceCommons/trace-commons-server">trace-commons-server</a>
      </p>
    </footer>
  </body>
</html>

<section class="hero">
  <div class="hero-copy">
    <div>
      <p class="hero-lead">Keep the data your agents produce.</p>
      <p class="body-text">
        Every time an AI agent works for you, it leaves a record of what it did.
        Trace Commons keeps that record on your own computer, lets you decide
        whether to share it, and pays you in credits when it helps make an AI
        better.
      </p>
    </div>

    <div class="hero-actions">
      <a
        class="btn btn-primary"
        href="https://github.com/TraceCommons"
        target="_blank"
        rel="noopener noreferrer">Start mining credits</a
      >
      <a
        class="btn btn-secondary"
        href="https://github.com/TraceCommons"
        target="_blank"
        rel="noopener noreferrer">Read the protocol</a
      >
    </div>
  </div>

  {/* main.js appends a WebGL canvas here. Anything that does not run WebGL —
      a link-preview bot, a text browser, a device where context creation
      fails — got an empty bordered box before this fallback existed. It is
      hidden by CSS the moment a canvas lands, so no script change is needed
      and the port stays byte-identical. */}
  <div class="hero-visual" id="canvas-container">
    <svg
      class="globe-fallback"
      viewBox="0 0 200 200"
      role="img"
      aria-label="A wireframe globe of linked records"
    >
      <circle cx="100" cy="100" r="72" fill="none" stroke="currentColor" stroke-width="1" />
      <ellipse cx="100" cy="100" rx="72" ry="26" fill="none" stroke="currentColor" stroke-width="1" />
      <ellipse cx="100" cy="100" rx="26" ry="72" fill="none" stroke="currentColor" stroke-width="1" />
      <ellipse cx="100" cy="100" rx="52" ry="72" fill="none" stroke="currentColor" stroke-width="1" />
      <line x1="100" y1="28" x2="100" y2="172" stroke="currentColor" stroke-width="1" />
      <circle cx="100" cy="28" r="3" fill="var(--accent)" />
      <circle cx="152" cy="120" r="3" fill="var(--accent)" />
      <circle cx="58" cy="72" r="3" fill="var(--accent)" />
    </svg>
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-5);
  }

  .hero-lead {
    font-size: clamp(28px, 3.4vw, 46px);
    line-height: 1;
    letter-spacing: -0.035em;
    font-weight: 700;
    text-transform: uppercase;
  }

  .hero-copy .body-text {
    margin-top: var(--space-4);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  .hero-visual {
    position: relative;
    width: 100%;
    min-height: clamp(300px, 46vh, 560px);
    border: var(--hairline);
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
  }

  /* horizontal drags spin the globe, vertical swipes still scroll the page */
  .globe-fallback {
    width: min(70%, 340px);
    height: auto;
    color: var(--ink-color);
    opacity: 0.55;
  }

  /* The canvas is appended after this element, so the moment WebGL succeeds
     the fallback goes. Both are centred by the same flex container, so there
     is no layout shift either way. */
  .hero-visual:has(canvas) .globe-fallback {
    display: none;
  }

  .hero-visual :global(canvas) {
    touch-action: pan-y;
    cursor: grab;
  }

  .hero-visual :global(canvas.is-grabbing) {
    cursor: grabbing;
  }

  @media (max-width: 1024px) {
    /* stacked hero: the globe takes whatever height the copy doesn't use */
    .hero {
      grid-template-columns: 1fr;
      grid-template-rows: auto 1fr;
    }

    .hero-visual {
      min-height: clamp(280px, 42vh, 460px);
    }
  }

  @media (max-width: 480px) {
    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>

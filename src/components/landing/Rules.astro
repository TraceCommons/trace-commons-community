<section class="section" id="rules">
  <div class="section-head">
    <h2 class="section-title">The rules</h2>
  </div>

  <div
    class="carousel"
    id="rules-carousel"
    tabindex="0"
    aria-roledescription="carousel"
    aria-label="The rules"
  >
    <div class="carousel-bar">
      <div class="carousel-count"><span id="rule-index">01</span> / 04</div>
      <div class="carousel-arrows">
        <button class="arrow" type="button" data-dir="-1" aria-label="Previous rule">&#8592;</button>
        <button class="arrow" type="button" data-dir="1" aria-label="Next rule">&#8594;</button>
      </div>
    </div>

    <div class="slides">
      <article class="slide is-active">
        <div class="slide-art">
          <svg class="art" viewBox="0 0 320 200" role="img" aria-label="A switch in the off position">
            <rect class="s" x="50" y="66" width="220" height="76" rx="38"></rect>
            <circle class="f" cx="88" cy="104" r="26"></circle>
            <circle class="d" cx="232" cy="104" r="26"></circle>
            <text class="t" x="50" y="40">Off</text>
            <text class="t muted" x="242" y="40">On</text>
          </svg>
        </div>
        <div class="slide-copy">
          <h3 class="slide-title">Off until you say so</h3>
          <p>
            Recording is switched off when you install. You turn it on, and you
            can turn it off again whenever you want.
          </p>
        </div>
      </article>

      <article class="slide">
        <div class="slide-art">
          <svg
            class="art"
            viewBox="0 0 320 200"
            role="img"
            aria-label="A document with the typed lines blacked out, leaving a device"
          >
            <rect class="s" x="20" y="30" width="150" height="140"></rect>
            <line class="s" x1="38" y1="58" x2="152" y2="58"></line>
            <rect class="f" x="38" y="76" width="80" height="12"></rect>
            <line class="s" x1="38" y1="106" x2="152" y2="106"></line>
            <rect class="f" x="38" y="122" width="112" height="12"></rect>
            <rect class="f" x="38" y="146" width="52" height="12"></rect>
            <line class="s" x1="182" y1="100" x2="248" y2="100"></line>
            <polyline class="s" points="236,90 250,100 236,110"></polyline>
            <rect class="s" x="262" y="70" width="42" height="60"></rect>
            <text class="t" x="20" y="192">Local</text>
            <text class="t" x="256" y="192">Upload</text>
          </svg>
        </div>
        <div class="slide-copy">
          <h3 class="slide-title">Cleaned on your computer</h3>
          <p>
            Whatever you typed is taken out before anything is sent. The raw
            version never leaves your machine.
          </p>
        </div>
      </article>

      <article class="slide">
        <div class="slide-art">
          <svg
            class="art"
            viewBox="0 0 320 200"
            role="img"
            aria-label="A record holding fingerprints, with the name column crossed out"
          >
            <rect class="s" x="20" y="34" width="280" height="132"></rect>
            <line class="s" x1="20" y1="66" x2="300" y2="66"></line>
            <line class="s" x1="196" y1="34" x2="196" y2="166"></line>
            <text class="t" x="32" y="56">Fingerprint</text>
            <text class="t muted" x="208" y="56">Your name</text>
            <rect class="f" x="32" y="80" width="140" height="10"></rect>
            <rect class="f" x="32" y="104" width="112" height="10"></rect>
            <rect class="f" x="32" y="128" width="150" height="10"></rect>
            <line class="s" x1="216" y1="82" x2="280" y2="140"></line>
            <line class="s" x1="280" y1="82" x2="216" y2="140"></line>
          </svg>
        </div>
        <div class="slide-copy">
          <h3 class="slide-title">A number, not a name</h3>
          <p>
            What we store is a fingerprint of your record and a score. Nothing in
            it points back to you.
          </p>
        </div>
      </article>

      <article class="slide">
        <div class="slide-art">
          <svg
            class="art"
            viewBox="0 0 320 200"
            role="img"
            aria-label="A tall stack of uploads earning nothing beside one scored trace earning a credit"
          >
            <rect class="s" x="34" y="60" width="86" height="14"></rect>
            <rect class="s" x="34" y="82" width="86" height="14"></rect>
            <rect class="s" x="34" y="104" width="86" height="14"></rect>
            <rect class="s" x="34" y="126" width="86" height="14"></rect>
            <text class="t" x="34" y="46">Sending</text>
            <text class="t muted" x="34" y="166">Earns nothing</text>
            <line class="s dash" x1="160" y1="34" x2="160" y2="176"></line>
            <rect class="fa" x="200" y="82" width="86" height="58"></rect>
            <polyline class="k" points="218,112 232,126 268,96"></polyline>
            <text class="t" x="200" y="46">Helping</text>
            <text class="t" x="200" y="166">Earns a credit</text>
          </svg>
        </div>
        <div class="slide-copy">
          <h3 class="slide-title">Helping counts, sending does not</h3>
          <p>
            Credits go to records that actually improved something. Sending more
            of them earns you nothing.
          </p>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .carousel {
    border: var(--hairline);
    outline: none;
  }

  .carousel:focus-visible {
    box-shadow: inset 0 0 0 3px var(--ink-color);
  }

  .carousel-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: var(--rule);
    padding-left: var(--space-4);
  }

  .carousel-count {
    font-family: var(--mono-font);
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--muted);
  }

  .carousel-count span {
    color: var(--ink-color);
  }

  .carousel-arrows {
    display: flex;
  }

  .arrow {
    width: 54px;
    height: 54px;
    background: var(--bg-color);
    border: none;
    border-left: var(--rule);
    color: var(--ink-color);
    font-family: var(--mono-font);
    font-size: 20px;
    line-height: 1;
    cursor: pointer;
  }

  .arrow:hover {
    background: var(--accent);
    color: var(--on-accent);
  }

  .slides {
    position: relative;
  }

  .slide {
    display: none;
    grid-template-columns: minmax(280px, 40%) 1fr;
    align-items: stretch;
    min-height: clamp(240px, 40vh, 400px);
  }

  .slide.is-active {
    display: grid;
  }

  .slide-art {
    background: var(--tint);
    border-right: var(--rule);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-4);
  }

  .slide-art svg {
    width: 100%;
    height: auto;
    max-height: 280px;
  }

  .slide-copy {
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-1);
  }

  .slide-title {
    font-size: clamp(26px, 3vw, 40px);
    line-height: 0.95;
    text-transform: uppercase;
    letter-spacing: -0.035em;
    font-weight: 700;
  }

  .slide-copy p {
    font-size: 19px;
    line-height: 1.25;
    font-weight: 500;
    letter-spacing: -0.01em;
    max-width: 46ch;
  }

  /* ---------- diagrams ---------- */

  .art {
    width: 100%;
    height: auto;
  }

  .art .s {
    fill: none;
    stroke: var(--ink-color);
    stroke-width: 2;
  }

  .art .dash {
    stroke-dasharray: 6 5;
  }

  .art .f {
    fill: var(--ink-color);
  }

  .art .fa {
    fill: var(--accent);
  }

  .art .d {
    fill: none;
    stroke: var(--ink-color);
    stroke-width: 2;
    stroke-dasharray: 5 5;
  }

  .art .k {
    fill: none;
    stroke: var(--ink-color);
    stroke-width: 4;
  }

  .art .t {
    font-family: var(--mono-font);
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    fill: var(--ink-color);
  }

  .art .muted {
    fill: var(--muted);
  }

  @media (max-width: 1024px) {
    .slide {
      grid-template-columns: 260px 1fr;
    }
  }

  @media (max-width: 640px) {
    .slide {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .slide-art {
      border-right: none;
      border-bottom: var(--rule);
    }
  }

  @media (max-width: 480px) {
    .slide-copy p {
      font-size: 17px;
    }

    .arrow {
      width: 48px;
      height: 48px;
    }
  }
</style>

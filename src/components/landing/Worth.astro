---
/* The manifesto. Six stanzas, one per paragraph of the original copy: the
   wording is untouched and the sentence order within each stanza is preserved.
   One clause per stanza is the headline — the one that states the claim — and
   the rest sets it up. */

const stanzas: { before?: string[]; headline: string; after?: string[] }[] = [
  {
    before: ["A machine knows only what it has been shown."],
    headline: "Everything it says, a person said first.",
  },
  {
    before: [
      "Set an agent to work and it leaves a record: every step, every failure, and what finally worked.",
      "No page holds it.",
    ],
    headline: "It does not exist until someone does the work.",
  },
  {
    headline: "Today that record is kept by the company that served the machine.",
    after: [
      "What you typed leaves your desk in plain view, and it will teach whatever comes next.",
    ],
  },
  {
    headline: "The record belongs to the person whose judgement made it.",
    after: [
      "It stays on your computer.",
      "Your words are taken out before anything leaves.",
      "A sealed system reads what remains and returns one number: whether the work taught a machine something new.",
    ],
  },
  {
    headline: "If it did, you earn credits that cannot be bought or sold.",
    after: ["They stay with you."],
  },
  {
    before: ["You are already doing the work."],
    headline: "Decide who learns from it.",
  },
];

const total = String(stanzas.length).padStart(2, "0");
---

<section class="section worth" id="worth" data-transcript>
  <div class="pin">
    <div class="transcript-stage">
      <div class="status-bar">
        <h2 class="transcript-name">What a trace is worth</h2>
        <p class="counter">
          <span data-stanza-counter>01</span> / {total}
        </p>
      </div>

      <div class="stanzas">
        {
          stanzas.map((stanza, i) => (
            <article class="stanza" data-state={i === 0 ? "live" : "future"}>
              {stanza.before?.map((line) => <p class="support">{line}</p>)}

              <p class="headline">{stanza.headline}</p>

              {stanza.after?.map((line) => <p class="support">{line}</p>)}

              <span class="cursor" aria-hidden="true" />
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  /* The stage carries its own black rather than relying on the page inversion.
     Without it the section would render yellow-on-white whenever the inversion
     does not run — scripts disabled, or motion reduced — which fails contrast
     badly. The inversion still flips the rest of the page around it. */
  .worth {
    padding: 0;
    gap: 0;
  }

  .transcript-stage {
    background: #000000;
    color: #ffffff;
    border: var(--hairline);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .status-bar {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-3);
    font-family: var(--mono-font);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
  }

  .transcript-name {
    font: inherit;
    color: inherit;
  }

  .counter {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .headline {
    font-size: clamp(28px, 4.4vw, 62px);
    line-height: 1.04;
    font-weight: 700;
    letter-spacing: -0.035em;
    color: var(--yellow);
    max-width: 20ch;
  }

  /* 0.72, above the 0.65 floor: mint at 0.45 over black measures 2.74:1, which
     is below AA for text the reader is currently being asked to read. */
  .support {
    font-family: var(--mono-font);
    font-size: clamp(13px, 1.25vw, 17px);
    line-height: 1.6;
    color: var(--accent);
    opacity: 0.72;
    max-width: 64ch;
  }

  .headline + .support {
    margin-top: var(--space-3);
  }

  .support + .headline {
    margin-top: var(--space-3);
  }

  .cursor {
    display: none;
    width: 0.6em;
    height: 1.1em;
    background: var(--accent);
    vertical-align: text-bottom;
  }

  /* ---------- static: no JS, or motion reduced ----------
     The default. Every stanza renders, stacked and still. This is the state the
     manifesto has to be readable in, because it carries the argument for the
     whole product. */

  .stanzas {
    display: flex;
    flex-direction: column;
    gap: var(--space-7);
  }

  /* ---------- pinned: set by transcript.js ---------- */

  .worth[data-mode="pinned"] .pin {
    height: 220vh;
  }

  .worth[data-mode="pinned"] .transcript-stage {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
  }

  .worth[data-mode="pinned"] .stanzas {
    position: relative;
    flex: 1;
    gap: 0;
  }

  /* The stanzas are stacked, so anything that fades out while the next fades in
     overlaps two lines of display type and reads as mush. The outgoing stanza is
     cut immediately — no transition on this rule — and only the incoming one
     fades. */
  .worth[data-mode="pinned"] .stanza {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
  }

  .worth[data-mode="pinned"] .stanza[data-state="live"] {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.25s ease;
  }

  .worth[data-mode="pinned"] .stanza[data-state="live"] .cursor {
    display: inline-block;
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @media (max-width: 640px) {
    /* 220vh of scroll to clear one section is a long time to hold a phone
       reader in place, and the lines are shorter here anyway. */
    .worth[data-mode="pinned"] .pin {
      height: 160vh;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .worth[data-mode="pinned"] .stanza,
    .cursor {
      transition: none;
      animation: none;
    }
  }
</style>

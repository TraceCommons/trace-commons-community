# Slice 2: live-API build wiring. Not used in Slice 1.
#
# TC_API_BASE: base URL of the upstream trace-commons-server
#   (without trailing slash). The build pipeline fetches
#   {TC_API_BASE}/v1/community/leaderboard etc. and caches the
#   responses under src/_data/snapshots/.
TC_API_BASE=https://ingest.34-41-15-28.nip.io

# Snapshot staleness threshold (seconds). CI fails the build if the
# fetched snapshot's computed_at is older than this. Default matches
# the snapshot worker interval (15 min) + buffer.
TC_SNAPSHOT_MAX_AGE_SECONDS=3600
